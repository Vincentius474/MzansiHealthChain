# Google AI Studio (Gemini)
GEMINI_API_KEY=

# Groq
GROQ_API_KEY=

# Tavily (web search)
TAVILY_API_KEY=

# Signs login tokens. Generate your own with: openssl rand -hex 32
JWT_SECRET=

# Avalanche Fuji Testnet
AVALANCHE_FUJI_RPC_URL=
AVALANCHE_CHAIN_ID=

# Wallet addresses (public)
DEPLOYER_ADDRESS=
RELAYER_ADDRESS=

# Private keys (NEVER COMMIT THESE)
DEPLOYER_PRIVATE_KEY=
RELAYER_PRIVATE_KEY=


# LangSmith tracing and evals. Tracing sends report text to LangSmith's cloud,
# so use fictional data only.
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=community-voice

# Turn the local privacy model off. Numbers and emails are still removed.
# PRIVACY_FILTER=false

# Use different models. These are the defaults.
# GEMINI_MODEL=gemini-3.1-flash-lite
# GROQ_MODEL=openai/gpt-oss-20b
# OLLAMA_MODEL=llama3.2:3b
# OLLAMA_BASE_URL=http://localhost:11434

JWT_SECRET=change-me-long-random
MASTER_KEY_HEX=64-hex-chars-32-bytes
RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
RELAYER_PRIVATE_KEY=0x...
REGISTRY_ADDR=0x...
CONSENT_ADDR=0x...
ACCESS_ADDR=0x...
AUDIT_ADDR=0x...
CORS_ORIGINS=http://localhost:3000
AUDIT_FROM_BLOCK=0
# Local Anvil demo accounts only; deploy setup enables these for chain 31337.
DEMO_AUTH_ENABLED=false
# With local demo auth and a loopback RPC, the API also permits localhost frontend dev ports.
# AI
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
TAVILY_API_KEY=
# Storage: leave SPACES_* empty to use ./data locally
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_BUCKET=
SPACES_KEY=
SPACES_SECRET=
